// Prisma schema for MongoDB-backed deployment requests
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  // Use MONGO_URI to align with existing .env; update FRONTEND.md accordingly
  url      = env("MONGO_URI")
}

enum RequestStatus {
  PENDING
  SCHEDULED
  PROVISIONED
  DECLINED
}

model DeploymentRequest {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  organizationName   String
  contactName        String
  contactEmail       String
  contactPhone       String?
  role               String?
  organizationSize   String?
  documentVolume     String?
  currentTools       String?
  complianceFocus    String?
  deploymentTimeline String?
  message            String
  status             RequestStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MANAGER)
  // Department the user belongs to (optional)
  department   String?
  // Granular permission grants (Discord-like matrix)
  grants       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Simple audit log for user changes
model UserAudit {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId      String   @db.ObjectId
  targetUserId String   @db.ObjectId
  action       String
  details      Json?
  createdAt    DateTime @default(now())
}

// Document metadata structure
model DocumentRecord {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  docId          String           @unique // external stable ID
  title          String
  originalFormat String
  totalPages     Int
  language       String
  nodeCount      Int?
  fullSummary    String
  overallMd      String?
  keywords       String[]
  metadata       DocumentMetadata
  raw            Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("documents")
}

// Document nodes for linked navigation
model DocumentNode {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  uid              String   @unique // format: ${docId}#${nodeId}
  docId            String
  nodeId           String
  order            Int
  title            String?
  titleNormalized  String?
  pageRange        Json // { start: number, end: number }
  sourcePages      Int[]
  content          String
  images           Json[] // ImageBlob[]
  summary          String
  summaryMd        String?
  keyPointsMd      String?
  actionsMd        String?
  keyPoints        String[]
  actionableItems  String[]
  keywords         String[]
  criticalFlags    String[]
  crossDepartments String[]
  needsImage       Boolean?
  meta             Json?
  nextNodeId       String?
  prevNodeId       String?
  nodeCount        Int?
  department       String?
  documentType     String?
  tags             String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([docId, order])
  @@index([titleNormalized])
  @@map("document_nodes")
}

// Chat sessions for conversation history
model ChatSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String   @unique
  userId    String   @db.ObjectId
  docId     String?
  messages  Json[] // ChatMessage[]
  citations Json[] // Citation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, docId])
  @@map("chat_sessions")
}

// Vector search documents (managed by LangChain)
model VectorDocument {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  textContent String
  embedding   Float[]
  metadata    Json
  createdAt   DateTime @default(now())

  @@map("vector_documents")
}

// Embedded types (not actual models, but for documentation)
type DocumentMetadata {
  createdAt    DateTime
  uploadedBy   String    @db.ObjectId
  department   String?
  documentType String?
  tags         String[]
  inferred     Json?
  updatedAt    DateTime?
}

type ImageBlob {
  page     Int?
  base64   String?
  url      String?
  mimeType String
  caption  String?
}
